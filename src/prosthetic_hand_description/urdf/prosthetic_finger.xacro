<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prosthetic_finger">

  <!-- ============ PARAMETERS (easily tunable) ============ -->
  <xacro:property name="palm_length" value="0.08"/>
  <xacro:property name="palm_width"  value="0.04"/>
  <xacro:property name="palm_height" value="0.02"/>

  <xacro:property name="proximal_length" value="0.05"/>
  <xacro:property name="proximal_radius" value="0.012"/>

  <xacro:property name="distal_length" value="0.04"/>
  <xacro:property name="distal_radius" value="0.010"/>

  <xacro:property name="tip_radius" value="0.005"/>

  <!-- ============ COLORS ============ -->
  <material name="skin">
    <color rgba="0.9 0.8 0.7 1.0"/>
  </material>
  <material name="bone">
    <color rgba="0.95 0.95 0.85 1.0"/>
  </material>
  <material name="tip_sensor">
    <color rgba="0.2 0.6 0.9 1.0"/>
  </material>

  <!-- ============ BASE LINK (palm attachment) ============ -->
  <link name="base_link"/>

  <!-- ============ PALM LINK ============ -->
  <link name="palm">
    <visual>
      <geometry>
        <box size="${palm_length} ${palm_width} ${palm_height}"/>
      </geometry>
      <origin xyz="${palm_length/2} 0 0" rpy="0 0 0"/>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry>
        <box size="${palm_length} ${palm_width} ${palm_height}"/>
      </geometry>
      <origin xyz="${palm_length/2} 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_palm" type="fixed">
    <parent link="base_link"/>
    <child link="palm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============ PROXIMAL PHALANX ============ -->
  <link name="proximal_phalanx">
    <visual>
      <geometry>
        <cylinder length="${proximal_length}" radius="${proximal_radius}"/>
      </geometry>
      <origin xyz="0 0 ${-proximal_length/2}" rpy="0 0 0"/>
      <material name="bone"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${proximal_length}" radius="${proximal_radius}"/>
      </geometry>
      <origin xyz="0 0 ${-proximal_length/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.000005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- MCP Joint (Metacarpophalangeal) - rotates around Y axis (flexion) -->
  <joint name="mcp_joint" type="revolute">
    <parent link="palm"/>
    <child link="proximal_phalanx"/>
    <origin xyz="${palm_length} 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.2" upper="1.8" effort="10.0" velocity="2.0"/>
  </joint>

  <!-- ============ DISTAL PHALANX ============ -->
  <link name="distal_phalanx">
    <visual>
      <geometry>
        <cylinder length="${distal_length}" radius="${distal_radius}"/>
      </geometry>
      <origin xyz="0 0 ${-distal_length/2}" rpy="0 0 0"/>
      <material name="bone"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${distal_length}" radius="${distal_radius}"/>
      </geometry>
      <origin xyz="0 0 ${-distal_length/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.000005" iyy="0.000005" izz="0.000002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- PIP Joint (Proximal Interphalangeal) -->
  <joint name="pip_joint" type="revolute">
    <parent link="proximal_phalanx"/>
    <child link="distal_phalanx"/>
    <origin xyz="0 0 ${-proximal_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="2.0" effort="8.0" velocity="2.0"/>
  </joint>

  <!-- ============ FINGERTIP (with tactile sensor pad) ============ -->
  <link name="fingertip">
    <visual>
      <geometry>
        <sphere radius="${tip_radius}"/>
      </geometry>
      <material name="tip_sensor"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${tip_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000001" iyy="0.0000001" izz="0.0000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="distal_to_tip" type="fixed">
    <parent link="distal_phalanx"/>
    <child link="fingertip"/>
    <origin xyz="0 0 ${-distal_length}" rpy="0 0 0"/>
  </joint>

</robot>
