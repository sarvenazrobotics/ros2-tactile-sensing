<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_hand">

  <!-- Colors -->
  <material name="palm_color"><color rgba="0.8 0.8 0.8 1.0"/></material>
  <material name="finger_color"><color rgba="0.2 0.6 0.9 1.0"/></material>
  <material name="tip_color"><color rgba="0.9 0.2 0.2 1.0"/></material>

  <!-- Base Link -->
  <link name="base_link"/>

  <!-- Palm -->
  <link name="palm">
    <visual>
      <geometry><box size="0.10 0.10 0.03"/></geometry>
      <material name="palm_color"/>
    </visual>
    <collision>
      <geometry><box size="0.10 0.10 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_palm" type="fixed">
    <parent link="base_link"/>
    <child link="palm"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </joint>

  <!-- Index Finger -->
  <link name="index_proximal">
    <visual>
      <geometry><cylinder radius="0.015" length="0.06"/></geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <material name="finger_color"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.06"/></geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.00005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="index_mcp" type="revolute">
    <parent link="palm"/>
    <child link="index_proximal"/>
    <origin xyz="0.03 0.03 0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.5" effort="5.0" velocity="2.0"/>
  </joint>

  <link name="index_distal">
    <visual>
      <geometry><cylinder radius="0.012" length="0.05"/></geometry>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <material name="finger_color"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.012" length="0.05"/></geometry>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" iyy="0.00005" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="index_pip" type="revolute">
    <parent link="index_proximal"/>
    <child link="index_distal"/>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.0" effort="5.0" velocity="2.0"/>
  </joint>

  <link name="index_tip">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="tip_color"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="index_to_tip" type="fixed">
    <parent link="index_distal"/>
    <child link="index_tip"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
  </joint>

</robot>

